# Dockerfile para API Spring Boot com Java 25
# Estratégia: Como Java 25 ainda não tem imagens oficiais Docker disponíveis,
# este Dockerfile espera que o JAR seja compilado LOCALMENTE com Java 25.
# A imagem runtime usa Java 21 (compatível com bytecode Java 25 com --release).

# Compile localmente ANTES de fazer build da imagem:
#   mvnw.cmd clean package -DskipTests   (Windows)
# ou:
#   ./mvnw clean package -DskipTests     (Linux/Mac)

FROM eclipse-temurin:21-jre
WORKDIR /app

# Copia o JAR já compilado da pasta target local
COPY target/*.jar /app/app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]

