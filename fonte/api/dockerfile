# Multi-stage build: compila com Maven Java 25 e roda com OpenJDK 25
FROM maven:3.9-openjdk-25-slim AS builder
WORKDIR /workspace

# Copia arquivos do projeto
COPY pom.xml ./
COPY src ./src

# Compila o projeto (pula testes para build mais rápido)
RUN mvn -B -DskipTests package

# Stage final: usa OpenJDK 25 para rodar a aplicação
FROM openjdk:25-jdk-alpine
WORKDIR /app

# Copia o JAR compilado do stage anterior
COPY --from=builder /workspace/target/*.jar /app/app.jar

# Expõe a porta padrão do Spring Boot
EXPOSE 8080

# Comando para iniciar a aplicação
ENTRYPOINT ["java", "-jar", "/app/app.jar"]


