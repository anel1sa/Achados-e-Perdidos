# Fase de compilação
FROM maven:3.9-openjdk-21-slim AS builder
WORKDIR /app

# Baixa as dependências primeiro (melhor cache)
COPY pom.xml .
RUN mvn dependency:resolve

# Copia o código-fonte e compila
COPY src ./src
RUN mvn clean package -DskipTests

# Fase de produção - usa imagem mais leve
FROM openjdk:21-jre-slim
WORKDIR /app

# Cria usuário não-root para segurança
RUN addgroup --system spring && adduser --system spring --ingroup spring
USER spring:spring

# Copia o JAR compilado do stage anterior
COPY --from=builder /app/target/*.jar app.jar

# Expõe a porta padrão do Spring Boot
EXPOSE 8080

# Comando para iniciar a aplicação com otimizações JVM
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]



