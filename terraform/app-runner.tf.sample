
# Repositório no ECR
resource "aws_ecr_repository" "achados_api" {
  name = "achados-e-perdidos-api"
}

# Role para o App Runner acessar o ECR
resource "aws_iam_role" "apprunner_role" {
  name = "achados-apprunner-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect = "Allow"
      Principal = {
        Service = "build.apprunner.amazonaws.com"
      }
      Action = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "apprunner_ecr" {
  role       = aws_iam_role.apprunner_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSAppRunnerServicePolicyForECRAccess"
}

# Serviço App Runner
resource "aws_apprunner_service" "achados_api_service" {
  service_name = "achados-api-service"

  source_configuration {
    image_repository {
      image_identifier      = "${aws_ecr_repository.achados_api.repository_url}:latest"
      image_repository_type = "ECR"

      image_configuration {
        port = "8080"

        runtime_environment_variables = {
          SPRING_DATASOURCE_URL      = "jdbc:mysql://meu-banco.cle34.aws-region.rds.amazonaws.com:3306/achados"
          SPRING_DATASOURCE_USERNAME = "admin"
          SPRING_DATASOURCE_PASSWORD = "senha123"
          MONGODB_URI                = "mongodb+srv://usuario:senha@cluster.mongodb.net/achados"
          AWS_REGION                 = "us-east-1"
          STORAGE_BUCKET             = "${var.base_name}-${var.env}-backend"
        }
      }
    }

    authentication_configuration {
      access_role_arn = aws_iam_role.apprunner_role.arn
    }

    auto_deployments_enabled = true
  }

  instance_configuration {
    cpu    = "1024"   # 1 vCPU
    memory = "2048"   # 2 GB RAM
  }

  tags = {
    Project = "achados_e_perdidos"
    Owner   = "Anelisa"
  }
}

# Saída com a URL do serviço
output "app_runner_url" {
  description = "URL pública do App Runner"
  value       = aws_apprunner_service.achados_api_service.service_url
}
